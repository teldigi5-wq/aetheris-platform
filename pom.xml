<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.aetheris</groupId>
  <artifactId>aetheris-platform</artifactId>
  <version>0.3.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <modules>
    <module>gateway</module>
    <module>user-service</module>
    <module>identity-service</module>
    <module>audit-service</module>
  </modules>

  <!-- GCS copy of Maven Central, tried before Central (which stays as the automatic
       fallback). Shared CI runners are rate-limited by Central (HTTP 429). Checksums are
       verified strictly (.mvn/maven.config, image MAVEN_ARGS). Not a mirrorOf. -->
  <repositories>
    <repository>
      <id>gcs-maven-central</id>
      <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>gcs-maven-central</id>
      <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>false</enabled></snapshots>
    </pluginRepository>
  </pluginRepositories>
</project>
