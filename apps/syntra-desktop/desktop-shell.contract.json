{
  "name": "Syntra Desktop",
  "stage": 6,
  "desktopVersion": "0.3.0-installer-hardening",
  "apiBase": "/api/orchestrator",
  "liveStream": "/api/orchestrator/live/events",
  "runtimeHealthProbe": {
    "method": "GET",
    "loopbackHost": "127.0.0.1",
    "defaultPort": 8090,
    "path": "/actuator/health",
    "readOnly": true
  },
  "controls": ["STOP", "PAUSE", "RESUME", "TAKE_CONTROL", "APPROVE", "REJECT"],
  "hostPairing": "challenge-response",
  "hostExecutionDefault": "simulation-only",
  "secretStorage": "os-backed-required-for-production",
  "packagingStatus": "unsigned-ci-nsis-installer",
  "installer": {
    "format": "nsis",
    "installMode": "currentUser",
    "codeSigningStatus": "unsigned-development-only",
    "checksumManifest": "SHA256SUMS.txt"
  },
  "desktopUiStatus": "multi-panel-pre-pc-shell",
  "backendCommandWiringStatus": "not-wired-no-success-claims",
  "readOnlyRuntimeIntegrationStatus": "health-only",
  "physicalPcStatus": "BLOCKED_PENDING_HARDWARE",
  "productionActivationAllowed": false
}
