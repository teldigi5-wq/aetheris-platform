// Files are exported by a trusted host-side operator, not Docker API access.
// Alloy cannot control the Docker daemon or enumerate container secrets.
loki.source.file "aetheris" {
  targets = [
    { __path__ = "/var/log/aetheris/gateway.log", service = "gateway" },
    { __path__ = "/var/log/aetheris/user-service.log", service = "user-service" },
    { __path__ = "/var/log/aetheris/identity-service.log", service = "identity-service" },
    { __path__ = "/var/log/aetheris/audit-service.log", service = "audit-service" },
    { __path__ = "/var/log/aetheris/orchestrator-service.log", service = "orchestrator-service" },
  ]
  forward_to = [loki.write.local.receiver]
  tail_from_end = false
  file_match {
    enabled = true
    sync_period = "5s"
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
