      "targets": [{"expr": "sum by (application) (rate(http_server_requests_seconds_sum[1m])) / clamp_min(sum by (application) (rate(http_server_requests_seconds_count[1m])), 0.001)", "legendFormat": "{{application}}", "refId": "A"}],
      "title": "Average HTTP latency",
