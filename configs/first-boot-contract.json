{
  "schema_version": 1,
  "stage": 25,
  "name": "Aetheris First-Boot Readiness Contract — Platform + External AI Runtime",
  "foundation_scope": "aetheris-platform-external-ai-runtime-v1",
  "truth_boundary": "This file defines expected requirements only. It is not evidence that the owner's physical PC exists or has passed validation.",
  "host": {
    "supported_os": ["Windows 11 x64"],
    "minimum_ram_gib": 16,
    "preferred_ram_gib": 24,
    "minimum_free_disk_gib": 100,
    "virtualization_required": true,
    "wsl2_required": true,
    "docker_desktop_required": true,
    "gpu": {
      "required_for_core_platform": false,
      "required_for_accelerated_local_ai": true,
      "minimum_vram_gib_for_accelerated_profile": 6
    }
  },
  "toolchain": {
    "java": "21.0.12",
    "maven": "3.9.11",
    "node": "22.23.2",
    "python": "3.13.15",
    "git": "required",
    "docker": "required",
    "docker_compose": "required"
  },
  "required_repository_files": [
    ".java-version",
    ".nvmrc",
    ".python-version",
    ".mvn/maven.config",
    ".mvn/wrapper/maven-wrapper.properties",
    "mvnw",
    "mvnw.cmd",
    "docker-compose.core.yml",
    "docker-compose.integration-external.yml",
    "architecture/ai-runtime-certification-reference.json",
    "gateway/pom.xml",
    "user-service/pom.xml",
    "identity-service/pom.xml",
    "audit-service/pom.xml",
    "dashboard/package-lock.json",
    "docs/dependency-policy.md",
    "scripts/check_dependency_lockdown.py",
    "scripts/stage22/release_gate.py",
    "scripts/stage22/schema_guard.py",
    "scripts/stage22/generate_sbom.py",
    "scripts/stage22/release_manifest.py",
    "scripts/stage22/merge_readiness.py",
    "scripts/stage23/contract_baseline.py",
    "scripts/stage23/contract_guard.py",
    "scripts/stage23/expected-contract.sha256"
  ],
  "platform_compose_file": "docker-compose.core.yml",
  "external_integration_compose_file": "docker-compose.integration-external.yml",
  "required_platform_services": [
    "postgres",
    "redis",
    "rabbitmq",
    "gateway",
    "identity-service",
    "user-service",
    "audit-service",
    "dashboard"
  ],
  "expected_platform_ports": [
    3000,
    5432,
    5672,
    6379,
    8080,
    8081,
    8082,
    8083,
    15672
  ],
  "external_ai_runtime": {
    "repository": "teldigi5-wq/aetheris-ai-runtime",
    "certified_sha": "65a6262717adcd52ac8d8a16ed6f223e299fd74d",
    "certification_reference": "architecture/ai-runtime-certification-reference.json",
    "service": "orchestrator-service",
    "port": 8090,
    "image_env": "AETHERIS_AI_RUNTIME_IMAGE",
    "required_image_expression": "${AETHERIS_AI_RUNTIME_IMAGE:?AETHERIS_AI_RUNTIME_IMAGE must be an exact-revision image}"
  },
  "physical_pc_evidence_required": [
    "host-inventory.json",
    "virtualization-status.txt",
    "wsl-status.txt",
    "docker-info.txt",
    "toolchain-versions.txt",
    "first-build.sha256",
    "second-build.sha256",
    "service-health.txt",
    "orchestrator-health.txt",
    "workstation-agent-validation.txt",
    "observability-health.txt"
  ],
  "forbidden_claims_before_physical_validation": [
    "Docker Desktop works on the owner's PC",
    "WSL2 works on the owner's PC",
    "GPU acceleration works on the owner's PC",
    "local AI performance has been benchmarked on the owner's PC",
    "the workstation agent has passed owner-PC activation",
    "the complete stack has passed physical-machine end-to-end testing"
  ]
}
