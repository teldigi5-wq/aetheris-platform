{
  "schema_version": 1,
  "scope": "core-platform",
  "truth_boundary": "Repository evidence demonstrates source/configuration and CI-verifiable design. Runtime screenshots, external-user adoption, production readiness, and physical-PC validation require separate evidence.",
  "claims": [
    {
      "id": "identity.refresh-token-lifecycle",
      "title": "Refresh tokens are generated with secure randomness, stored by SHA-256 hash, atomically single-use during rotation, and revocable",
      "maturity": "REPOSITORY_TESTED",
      "evidence": [
        {
          "path": "identity-service/src/main/java/io/aetheris/identity/RefreshTokenService.java",
          "contains": [
            "new SecureRandom()",
            "MessageDigest.getInstance(\"SHA-256\")",
            "public RotationResult rotate(String rawToken)",
            "repository.revokeIfActive(tokenHash, Instant.now())",
            "public void revoke(String rawToken)"
          ]
        },
        {
          "path": "identity-service/src/test/java/io/aetheris/identity/RefreshTokenServiceTest.java",
          "contains": [
            "service.rotate(first.token())",
            "rotationRejectsRequestThatLosesAtomicClaimRace"
          ]
        }
      ]
    },
    {
      "id": "identity.browser-refresh-cookie-boundary",
      "title": "Dashboard refresh credentials are HttpOnly cookie-bound, same-origin checked, non-cacheable, and never returned as raw browser JSON",
      "maturity": "REPOSITORY_TESTED",
      "evidence": [
        {
          "path": "identity-service/src/main/java/io/aetheris/identity/BrowserAuthController.java",
          "contains": [
            "httpOnly(true)",
            "sameSite(\"Strict\")",
            "secure(secureCookie)",
            "CacheControl.noStore()",
            "authority.equalsIgnoreCase(browserHost)"
          ]
        },
        {
          "path": "identity-service/src/main/java/io/aetheris/identity/AuthDtos.java",
          "contains": [
            "COOKIE_BOUND_REFRESH = \"COOKIE_BOUND\""
          ]
        },
        {
          "path": "dashboard/nginx.conf",
          "contains": [
            "location = /api/auth/refresh",
            "X-Aetheris-Browser \"aetheris-dashboard-v1\"",
            "X-Aetheris-Browser-Host $http_host",
            "location ^~ /api/auth/browser/"
          ]
        },
        {
          "path": "identity-service/src/test/java/io/aetheris/identity/BrowserAuthControllerTest.java",
          "contains": [
            "loginSetsProtectedCookieAndReturnsOnlyBindingSentinel",
            "rejectsMissingOrCrossOriginBrowserRequest"
          ]
        },
        {
          "path": "tools/browser_auth_runtime_smoke.py",
          "contains": [
            "browser.registration-cookie-bound",
            "browser.refresh-rotates-cookie",
            "browser.cross-origin-refresh-rejected",
            "browser.logout-revokes-cookie"
          ]
        }
      ]
    },
    {
