# Copy to .env and replace EVERY blank value with a distinct random secret.
# Never commit .env; the repository .gitignore excludes it.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Do not use shared/example passwords or the previous JWT fallback.
AETHERIS_POSTGRES_PASSWORD=
AETHERIS_RABBITMQ_PASSWORD=
AETHERIS_JWT_SECRET=
AETHERIS_GRAFANA_ADMIN_PASSWORD=

# Only for isolated HTTP loopback-only local testing; browser cookies are Secure by default.
# AETHERIS_BROWSER_REFRESH_COOKIE_SECURE=false

# Optional certified runtime image and loopback-only model URL.
# AETHERIS_AI_RUNTIME_IMAGE=
# AETHERIS_LOCAL_MODEL_BASE_URL=http://host.docker.internal:11434
